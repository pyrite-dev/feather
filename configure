#!/bin/sh
PREFIX="/usr/fhttpd"
TARGET="`uname -s`"

EMBED="dso"
MODULES=""

SSLopt="define"
MULTITHREADopt="define"

AR='ar'
ARFLAGS='rcs'
CC='cc'
CFLAGS=''
RC='windres'
RCFLAGS=''
STRIP='strip'

PIC='-fPIC'

RPATH='-Wl,-R$(PREFIX)/lib'

SSL=''
THREAD='$(LINK)pthread'
FPR='$(LINK)fpr'

A='.a'
SO='.so'
O='.o'
E=''

RESFILE=''

AFTER=''

for i in "$@"; do
	case "$i" in
		--target=*)
			TARGET="`echo "$i" | cut -d= -f2-`"
			;;
		--embed=*)
			EMBED="`echo "$i" | cut -d= -f2-`"
			;;
		--embed=*)
			MODULES="`echo "$i" | cut -d= -f2-`"
			;;
	esac
done

if [ -f "ostype/$TARGET.sh" ]; then
	. ostype/$TARGET.sh
fi

for i in "$@"; do
	case "$i" in
		--prefix=*)
			PREFIX="`echo "$i" | cut -d= -f2-`"
			;;
		--target=*)
			;;
		--embed=*)
			;;
		--module=*)
			no_dso=true
			for j in "$EMBED"; do
				if [ "$j" = "dso" ]; then
					no_dso=false
					break
				fi
			done
			if $no_dso; then
				echo "Module needs DSO to work, pass dso to --embed"
				exit 1
			fi
			;;
		--enable-*)
			eval `echo "$i" | cut -d- -f4 | tr "[:lower:]" "[:upper:]"`opt="define"
			;;
		--disable-*)
			eval `echo "$i" | cut -d- -f4 | tr "[:lower:]" "[:upper:]"`opt="undef"
			;;
		--help)
			echo "Usage: $0 [options]"
			echo ""
			echo "Options:"
			echo "	--prefix=TARGET    Specify prefix"
			echo "	--target=TARGET    Specify target"
			echo "	--enable-OPTION    Enable option"
			echo "	--disable-OPTION   Disable option"
			echo "	--help             Show this help"
			echo ""
			echo "Tunable options:"
			echo "	ssl multithread"
			exit 0
			;;
		*)
			echo "Invalid argument"
			exit 1
			;;
	esac
done

if [ "$SSLopt" = "define" ]; then
	SSL='$(LINK)ssl $(LINK)crypto'
fi

cat > config.mk << EOF
PREFIX	= $PREFIX

# Modules to embed
EMBED	= $EMBED

# Do not disable these modules, unless you know what it means
EMBED += dir file error

# DSO modules to compile
MODULES = $MODULES

AR	= $AR
ARFLAGS	= $ARFLAGS
CC 	= $CC
CFLAGS	= $CFLAGS
RC	= $RC
RCFLAGS	= $RCFLAGS
STRIP	= $STRIP
LDFLAGS = $LDFLAGS
LIBS	= $LIBS

# Compiler flag for Position Independent Code
PIC	= $PIC

# Compiler flag to include directory
INCDIR	= -I

# Compiler flag to define macro
DEFINE	= -D

# Compiler flag to link library
LINK	= -l

# Linker flag for rpath
RPATH	= $RPATH

# Linker flag to include directory
LIBDIR =  -L

# Linker flag for SSL library
SSL	= $SSL

# Linker flag for thread
THREAD	= $THREAD

# Linker flag for FPR
FPR	= $FPR

# Linker flag for dynamic library
SHARED	= -shared

# Prefix for library
LIB	= lib

# Extension for archive
A	= $A

# Extension for DSO
SO	= $SO

# Extension for object
O	= $O

# Extension for executable
E	= $E

# Resource file output
RESFILE	= $RESFILE

# Commands to be ran after building
AFTER	= $AFTER
EOF

cat > config.h << EOF
#ifndef __CONFIG_H__
#define __CONFIG_H__

#define PREFIX "$PREFIX"

/* SSL support */
#$SSLopt HAS_SSL

/* Multithreaded or not */
#$MULTITHREADopt MULTITHREAD

/* this decides buffer size for config file and HTTP */
#define BUFFER_SIZE 1024

/* this decides how long line can be in config file */
#define LINE_SIZE BUFFER_SIZE

/* max length stuff - this does not include NUL terminator */
#define MAX_METHOD_LENGTH 128
#define MAX_PATH_LENGTH 1024
#define MAX_QUERY_LENGTH 1024
#define MAX_VERSION_LENGTH 8 /* you DO NOT have to change this... */
#define MAX_STATUS_TEXT_LENGTH 1024

/* Modules to embed - also edit config.mk
 * Do NOT remove LOAD(dir), LOAD(file) and LOAD(error) unless you know
 * what it means...
 */
#define MODULES \\
EOF
for i in $EMBED; do
	echo "	LOAD($i) \\" >> config.h
done
cat >> config.h << EOF
	LOAD(dir) \\
	LOAD(file) \\
	LOAD(error)

#endif
EOF
